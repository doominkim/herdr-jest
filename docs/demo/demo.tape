Output demo.gif

Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 15
Set Width 1440
Set Height 760
Set Padding 14
Set Theme "Catppuccin Mocha"
Set TypingSpeed 60ms

Hide
Type "export HERDR_PLUGIN_STATE_DIR=/tmp/hj-demo/state PS1='' && cd /tmp/hj-demo/acme/shop && clear"
Enter
Type "/tmp/hj-demo/bin/herdr-jest ui --cwd ."
Enter
Sleep 3s
Show

Sleep 1.5s
Type "a"
Sleep 4s

Down
Sleep 400ms
Down
Sleep 400ms
Down
Sleep 400ms
Down
Sleep 3s

Type "s"
Sleep 3.5s
Type "s"
Sleep 1s

Type "v"
Sleep 2s
Type "-"
Sleep 1.5s
Type "="
Sleep 2s
Type "v"
Sleep 1s

Down
Sleep 400ms
Down
Sleep 600ms
Enter
Sleep 3s

Type "2"
Sleep 2s
Down
Sleep 2s

Type "?"
Sleep 2.5s
Escape
Sleep 500ms

Type "1"
Type "F"
Sleep 2.5s
Type "F"
Sleep 1.5s

Hide
Type "X"
Sleep 1s
